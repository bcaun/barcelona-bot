# Скопируйте этот файл в .env и заполните значения: cp .env.example .env
# Файл .env НЕ попадает в git.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-replace-me

# Telegram ID администраторов через запятую (узнать свой ID: написать @userinfobot)
ADMIN_IDS=123456789

# ID чата, куда приходят заявки (группа с ботом). Для групп начинается с -100...
ADMIN_CHAT_ID=-1001234567890

# Канал: @username публичного канала или числовой ID (-100...). Бот должен быть админом канала.
CHANNEL_ID=@barcelona_ru

# База данных. В Docker файл лежит в томе /data
DATABASE_URL=sqlite+aiosqlite:////data/bot.db

# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Оплата nota simple через Stripe внутри Telegram: токен от @BotFather → Payments → Stripe.
# Пусто — онлайн-оплата выключена (заявка без оплаты). Для теста — токен «Stripe TEST».
PAYMENT_PROVIDER_TOKEN=

# Фаза 3: домен мини-аппа (например game.barcelona.ru)
WEBAPP_DOMAIN=
